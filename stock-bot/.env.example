# Copy this file to a new file named .env (in this same folder) and paste your Alpaca PAPER keys after the = signs.
# Find them at https://app.alpaca.markets -> switch to Paper Trading -> API Keys. Paper key IDs start with "PK".
# .env is in .gitignore, so it never gets uploaded. Never paste your keys into a chat or a screenshot.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
