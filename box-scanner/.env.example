# Copy this file to .env (same folder) and fill it in. .env is git-ignored: it never gets uploaded.
# The bot never prints or logs these values.

# Alpaca PAPER keys: app.alpaca.markets -> Paper Trading -> API Keys. Paper key IDs start with "PK".
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Stock data feed: "iex" (free plan) or "sip" (paid plan, all US exchanges)
ALPACA_DATA_FEED=iex

# Optional alert channels (switch each one on in config.yaml)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NTFY_TOPIC=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
